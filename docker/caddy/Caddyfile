{
	layer4 {
		:222 {
			route {
				proxy forgejo:22
			}
		}
	}
}

(tls) {
	tls /root/certs/cert.pem /root/certs/key.pem
}

ntfy.app.home.arpa {
	import tls
	encode zstd gzip
	reverse_proxy ntfy:2586
}

forgejo.app.home.arpa {
	import tls
	reverse_proxy forgejo:3000
}

s3.app.home.arpa {
	import tls
	reverse_proxy rustfs:9000
}

rustfs.app.home.arpa {
	import tls
	reverse_proxy rustfs:9001
}

windmill.app.home.arpa {
	import tls

	@extra path /ws/* /ws_mp/* /ws_debug/*
	reverse_proxy @extra windmill-extra:3000

	reverse_proxy windmill:8000
}

rabbitmq.app.home.arpa {
	import tls
	reverse_proxy rabbitmq:15672
}

valkey-admin.app.home.arpa {
	import tls
	reverse_proxy valkey-admin:8080
}

plane.app.home.arpa {
	import tls
	redir /god-mode /god-mode/
	reverse_proxy plane-aio:80
}

inventree.app.home.arpa {
	import tls
	request_body {
		max_size 100MB
	}
	reverse_proxy inventree-proxy:80
}

arcane.app.home.arpa {
	import tls
	reverse_proxy arcane:3552
}

http://*.app.home.arpa {
	redir https://{host}{uri} permanent
}

*.app.home.arpa {
	import tls

	respond "no service at {host}" 404
}
